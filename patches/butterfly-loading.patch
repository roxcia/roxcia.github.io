+        background #f98db9
+      &.gear-top_hole
+        width 50px
+        height 50px
+        border-radius 100%
+        background white
+        position absolute
+        position absolute
+        left 0
+        right 0
+        top 0
+        bottom 0
+        margin auto
+  .gear-loader_cogs__left
+    position relative
+    width 80px
+    transform rotate(16deg)
+    top 28px
+    transform-origin 40px 40px
+    animation rotate_left 10s 0.1s infinite reverse linear
+    left -24px
+    height 80px
+    div
+      &:nth-of-type(1)
