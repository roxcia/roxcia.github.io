--- /dev/null
+++ b/source/js/sun_moon.js
@@ -0,0 +1,101 @@
+function switchNightMode () {
+  const body = document.body
+  const html = document.documentElement
+  const isLight = html.getAttribute('data-theme') !== 'dark'
+
+  body.insertAdjacentHTML('beforeend', '<div class="Cuteen_DarkSky"><div class="Cuteen_DarkPlanet"><div id="sun"></div><div id="moon"></div></div></div>')
+
+  const sky = document.querySelector('.Cuteen_DarkSky')
+  const sun = document.getElementById('sun')
+  const moon = document.getElementById('moon')
+
+  if (sun && moon) {
+    sun.style.opacity = isLight ? '1' : '0'
+    moon.style.opacity = isLight ? '0' : '1'
+
+    setTimeout(() => {
+      sun.style.opacity = isLight ? '0' : '1'
+      moon.style.opacity = isLight ? '1' : '0'
+    }, 1000)
+  }
+
+  if (isLight) {
+    btf.activateDarkMode()
+    btf.saveToLocal.set('theme', 'dark', 2)
+    body.classList.add('DarkMode')
+    setModeIcon('dark')
+    showModeNotice('关灯啦??', '当前已成功切换至夜间模式！')
+    handleThemeSideEffects('dark')
+  } else {
+    btf.activateLightMode()
+    btf.saveToLocal.set('theme', 'light', 2)
+    body.classList.remove('DarkMode')
+    setModeIcon('light')
+    showModeNotice('开灯啦??', '当前已成功切换至白天模式！')
+    handleThemeSideEffects('light')
+  }
+
+  setTimeout(() => {
+    if (!sky) return
+    sky.style.transition = 'opacity 3s'
+    sky.style.opacity = '0'
+
+    setTimeout(() => {
+      sky.remove()
+    }, 1000)
+  }, 2000)
+}
+
+function setModeIcon (mode) {
+  const modeIcon = document.getElementById('modeicon')
+  if (modeIcon) {
+    modeIcon.setAttribute('xlink:href', mode === 'dark' ? '#icon-sun' : '#icon-moon')
+    return
+  }
+
+  const icon = document.querySelector('#darkmode i')
+  if (!icon) return
+  icon.className = mode === 'dark' ? 'fas fa-sun' : 'fas fa-moon'
+}
+
+function showModeNotice (title, message) {
+  setTimeout(() => {
+    if (window.Vue && window.ELEMENT) {
+      new Vue({
+        data: function () {
+          this.$notify({
+            title,
+            message,
+            position: 'top-left',
+            offset: 50,
+            showClose: true,
+            type: 'success',
+            duration: 5000
+          })
+        }
+      })
+      return
+    }
+
+    if (window.btf && typeof btf.snackbarShow === 'function') {
+      btf.snackbarShow(message)
+    }
+  }, 2000)
+}
+
+function handleThemeSideEffects (mode) {
+  typeof utterancesTheme === 'function' && utterancesTheme()
+  typeof FB === 'object' && window.loadFBComment()
+  window.DISQUS && document.getElementById('disqus_thread')?.children.length && setTimeout(() => window.disqusReset(), 200)
+
+  const globalFn = window.globalFn || {}
+  const themeChange = globalFn.themeChange || {}
+  Object.keys(themeChange).forEach(key => {
+    const themeChangeFn = themeChange[key]
+    if (['disqus', 'disqusjs'].includes(key)) {
+      setTimeout(() => themeChangeFn(mode), 300)
+    } else {
+      themeChangeFn(mode)
+    }
+  })
+}
